-- Index de recherche plein texte des références (CDC §6.5, docs/architecture.md §3).
--
-- FTS5 découpe les textes en mots ; « remove_diacritics 2 » ignore les accents
-- et la casse : « saint emilion » trouve « Saint-Émilion ».
--
-- Contenu indexé pour chaque référence (schéma v4) :
--   - les champs texte de la fiche ;
--   - le nom du type (« Vin ») et des caractéristiques (« Rouge Sec ») :
--     « vin rouge » trouve les vins rouges (v3) ;
--   - les millésimes de ses lots : « 2015 » trouve les références ayant un
--     lot 2015, épuisé ou non (v4).
--
-- La vue drink_search_rows calcule la ligne d'index d'une référence ; tous les
-- déclencheurs l'utilisent, ainsi que CaveDatabase.rebuildSearchIndex(). Pour
-- indexer une nouvelle information : l'ajouter à la vue et à drinks_fts, puis
-- ajouter le déclencheur de la table qui la contient.
--
-- Les références supprimées (deleted_at) restent dans l'index et sont écartées
-- au moment de la recherche.

import 'tables.dart';

CREATE VIRTUAL TABLE drinks_fts USING fts5(
  drink_id UNINDEXED,
  name,
  producer,
  appellation,
  region,
  country,
  grapes,
  type_name,
  characteristics,
  vintages,
  tokenize = 'unicode61 remove_diacritics 2'
);

CREATE VIEW drink_search_rows AS
SELECT
  d.id AS drink_id,
  d.name AS name,
  d.producer AS producer,
  d.appellation AS appellation,
  d.region AS region,
  d.country AS country,
  d.grapes AS grapes,
  (SELECT t.name FROM drink_types t
     WHERE t.id = d.type_id AND t.deleted_at IS NULL) AS type_name,
  (SELECT group_concat(c.name, ' ') FROM drink_characteristics dc
     JOIN characteristics c ON c.id = dc.characteristic_id
     WHERE dc.drink_id = d.id AND dc.deleted_at IS NULL
       AND c.deleted_at IS NULL) AS characteristics,
  (SELECT group_concat(DISTINCT l.vintage) FROM lots l
     WHERE l.drink_id = d.id AND l.deleted_at IS NULL) AS vintages
FROM drinks d;

-- Une référence créée, modifiée ou effacée.
CREATE TRIGGER drinks_fts_insert AFTER INSERT ON drinks BEGIN
  DELETE FROM drinks_fts WHERE drink_id = new.id;
  INSERT INTO drinks_fts (drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages)
  SELECT drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages
  FROM drink_search_rows WHERE drink_id = new.id;
END;

CREATE TRIGGER drinks_fts_update AFTER UPDATE ON drinks BEGIN
  DELETE FROM drinks_fts WHERE drink_id = new.id;
  INSERT INTO drinks_fts (drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages)
  SELECT drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages
  FROM drink_search_rows WHERE drink_id = new.id;
END;

CREATE TRIGGER drinks_fts_delete AFTER DELETE ON drinks BEGIN
  DELETE FROM drinks_fts WHERE drink_id = old.id;
END;

-- Une caractéristique ajoutée, retirée (deleted_at) ou réactivée sur une référence.
CREATE TRIGGER drinks_fts_link_insert AFTER INSERT ON drink_characteristics BEGIN
  DELETE FROM drinks_fts WHERE drink_id = new.drink_id;
  INSERT INTO drinks_fts (drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages)
  SELECT drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages
  FROM drink_search_rows WHERE drink_id = new.drink_id;
END;

CREATE TRIGGER drinks_fts_link_update AFTER UPDATE ON drink_characteristics BEGIN
  DELETE FROM drinks_fts WHERE drink_id = new.drink_id;
  INSERT INTO drinks_fts (drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages)
  SELECT drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages
  FROM drink_search_rows WHERE drink_id = new.drink_id;
END;

-- Un lot créé, ou dont le millésime change ou qui est supprimé. « UPDATE OF »
-- évite de réindexer à chaque mise à jour du stock en cache.
CREATE TRIGGER drinks_fts_lot_insert AFTER INSERT ON lots BEGIN
  DELETE FROM drinks_fts WHERE drink_id = new.drink_id;
  INSERT INTO drinks_fts (drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages)
  SELECT drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages
  FROM drink_search_rows WHERE drink_id = new.drink_id;
END;

CREATE TRIGGER drinks_fts_lot_update AFTER UPDATE OF vintage, deleted_at ON lots BEGIN
  DELETE FROM drinks_fts WHERE drink_id = new.drink_id;
  INSERT INTO drinks_fts (drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages)
  SELECT drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages
  FROM drink_search_rows WHERE drink_id = new.drink_id;
END;

-- Un type renommé ou supprimé : toutes ses références sont réindexées.
CREATE TRIGGER drinks_fts_type_update AFTER UPDATE ON drink_types BEGIN
  DELETE FROM drinks_fts WHERE drink_id IN (SELECT id FROM drinks WHERE type_id = new.id);
  INSERT INTO drinks_fts (drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages)
  SELECT drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages
  FROM drink_search_rows
  WHERE drink_id IN (SELECT id FROM drinks WHERE type_id = new.id);
END;

-- Une caractéristique renommée ou supprimée : ses références sont réindexées.
CREATE TRIGGER drinks_fts_characteristic_update AFTER UPDATE ON characteristics BEGIN
  DELETE FROM drinks_fts WHERE drink_id IN
    (SELECT drink_id FROM drink_characteristics WHERE characteristic_id = new.id);
  INSERT INTO drinks_fts (drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages)
  SELECT drink_id, name, producer, appellation, region, country, grapes, type_name, characteristics, vintages
  FROM drink_search_rows
  WHERE drink_id IN (SELECT drink_id FROM drink_characteristics WHERE characteristic_id = new.id);
END;
