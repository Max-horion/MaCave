<?xml version="1.0" encoding="UTF-8"?>
<!-- Description de l'appli pour les logithèques et Gear Lever (AppStream),
     copiée dans l'AppImage par tool/paquet_linux.sh. -->
<component type="desktop-application">
  <id>fr.bouthon.cave</id>
  <name>Ma Cave</name>
  <summary>Gérer les bouteilles de sa cave personnelle</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="fr.bouthon">
    <name>Maxence Pithon</name>
  </developer>
  <description>
    <p>
      Gestion d'une cave personnelle (vins, bières, spiritueux…), entièrement
      hors ligne, avec synchronisation facultative sur votre serveur Nextcloud
      ou WebDAV.
    </p>
  </description>
  <launchable type="desktop-id">fr.bouthon.cave.desktop</launchable>
  <url type="homepage">https://github.com/Max-horion/MaCave</url>
  <url type="bugtracker">https://github.com/Max-horion/MaCave/issues</url>
  <content_rating type="oars-1.1"/>
</component>
