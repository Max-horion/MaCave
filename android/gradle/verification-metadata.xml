<?xml version="1.0" encoding="UTF-8"?>
<!-- Vérification des dépendances par Gradle (audit de sécurité du
     2026-10-17). Seule Tesseract4Android est vérifiée : elle vient de
     JitPack, qui construit les fichiers à la demande depuis GitHub (un
     fichier republié sous la même version passerait inaperçu). Les autres
     dépendances viennent de Google et de Maven Central et changent à chaque
     mise à jour de Flutter : elles sont admises sans empreinte.
     Empreintes relevées le 2026-10-17, identiques aux fichiers utilisés
     depuis le lot 5d. En cas de mise à jour de Tesseract4Android : relever
     les nouvelles empreintes (sha256sum des fichiers .aar, .pom, .module de
     https://jitpack.io/cz/adaptech/tesseract4android/…) et les remplacer. -->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <!-- Tout ce qui n'est pas du groupe cz.adaptech.tesseract4android. -->
         <trust group="^(?!cz[.]adaptech[.]tesseract4android$).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="cz.adaptech.tesseract4android" name="tesseract4android-openmp" version="4.9.0">
         <artifact name="tesseract4android-openmp-4.9.0.aar">
            <sha256 value="02b5968cc482ef6162dcdecad0000cc28f120becc089ccca2eefb8fadc12ab2b" origin="relevé le 2026-10-17"/>
         </artifact>
         <artifact name="tesseract4android-openmp-4.9.0.module">
            <sha256 value="09fdd9549ef9ae92b09c78ec103af5d7036f565fcd1d02c397fdb3e82cedeba0" origin="relevé le 2026-10-17"/>
         </artifact>
         <artifact name="tesseract4android-openmp-4.9.0.pom">
            <sha256 value="ad50083e8302482da79e69709da4373ac6bd4659ab9aed215985e1f74b22ba13" origin="relevé le 2026-10-17"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
