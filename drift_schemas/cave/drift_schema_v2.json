  "fixed_sql": [
    {
      "name": "drinks_fts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE VIRTUAL TABLE IF NOT EXISTS \"drinks_fts\" USING fts5(drink_id UNINDEXED, name, producer, appellation, region, country, grapes, tokenize = 'unicode61 remove_diacritics 2');"
        }
      ]
    },
    {
      "name": "drink_types",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"drink_types\" (\"id\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"updated_by\" TEXT NOT NULL, \"deleted_at\" INTEGER NULL, \"name\" TEXT NOT NULL, \"field_profile\" TEXT NOT NULL, \"default_volume_ml\" INTEGER NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "drinks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"drinks\" (\"id\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"updated_by\" TEXT NOT NULL, \"deleted_at\" INTEGER NULL, \"type_id\" TEXT NULL REFERENCES drink_types (id), \"name\" TEXT NOT NULL, \"producer\" TEXT NULL, \"appellation\" TEXT NULL, \"region\" TEXT NULL, \"country\" TEXT NULL, \"grapes\" TEXT NULL, \"abv\" REAL NULL, \"rating\" INTEGER NULL, \"favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"favorite\" IN (0, 1)), \"comment\" TEXT NULL, \"needs_completion\" INTEGER NOT NULL DEFAULT 0 CHECK (\"needs_completion\" IN (0, 1)), \"food_pairing\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "drinks_fts_insert",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER drinks_fts_insert AFTER INSERT ON drinks BEGIN INSERT INTO drinks_fts (drink_id, name, producer, appellation, region, country, grapes) VALUES (new.id, new.name, new.producer, new.appellation, new.region, new.country, new.grapes);END"
        }
      ]
    },
    {
      "name": "drinks_fts_update",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER drinks_fts_update AFTER UPDATE ON drinks BEGIN DELETE FROM drinks_fts WHERE drink_id = old.id;INSERT INTO drinks_fts (drink_id, name, producer, appellation, region, country, grapes) VALUES (new.id, new.name, new.producer, new.appellation, new.region, new.country, new.grapes);END"
        }
      ]
    },
    {
      "name": "drinks_fts_delete",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER drinks_fts_delete AFTER DELETE ON drinks BEGIN DELETE FROM drinks_fts WHERE drink_id = old.id;END"
        }
      ]
    },
    {
      "name": "characteristic_families",
      "sql": [
        {
