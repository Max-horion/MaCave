        "name": "drinks_fts_update",
        "sql": "CREATE TRIGGER drinks_fts_update AFTER UPDATE ON drinks BEGIN\n  DELETE FROM drinks_fts WHERE drink_id = old.id;\n  INSERT INTO drinks_fts (drink_id, name, producer, appellation, region, country, grapes)\n  VALUES (new.id, new.name, new.producer, new.appellation, new.region, new.country, new.grapes);\nEND;"
      }
